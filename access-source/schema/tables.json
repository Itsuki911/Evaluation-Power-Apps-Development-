{
  "metadata": {
    "fileCategory": "custom_auxiliary",
    "isSimulatedAccessExport": false,
    "description": "Logical Access table schema definitions aligned with the Excel data sources."
  },
  "tables": [
    {
      "name": "Employees",
      "isLinkedTable": true,
      "linkedSource": {
        "workbook": "data/Employees.xlsx",
        "worksheet": "Employees",
        "excelTableName": "EmployeesTable"
      },
      "primaryKey": ["EmployeeID"],
      "columns": [
        {
          "name": "EmployeeID",
          "accessType": "Short Text",
          "maxLength": 10,
          "excelFormat": "@",
          "nullable": false,
          "unique": true,
          "description": "Unique employee identifier (e.g., EMP001)."
        },
        {
          "name": "EmployeeName",
          "accessType": "Short Text",
          "maxLength": 100,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "description": "Full name of the employee."
        },
        {
          "name": "Department",
          "accessType": "Short Text",
          "maxLength": 50,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "description": "Department to which the employee belongs."
        },
        {
          "name": "Status",
          "accessType": "Short Text",
          "maxLength": 20,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "allowedValues": ["Active", "Inactive"],
          "description": "Employment status. Only Active employees can clock in or out."
        }
      ]
    },
    {
      "name": "AttendanceRecords",
      "isLinkedTable": true,
      "linkedSource": {
        "workbook": "data/AttendanceRecords.xlsx",
        "worksheet": "AttendanceRecords",
        "excelTableName": "AttendanceRecordsTable"
      },
      "primaryKey": ["AttendanceID"],
      "columns": [
        {
          "name": "AttendanceID",
          "accessType": "Short Text",
          "maxLength": 20,
          "excelFormat": "@",
          "nullable": false,
          "unique": true,
          "pattern": "^ATT-[0-9]{8}-[0-9]{3}$",
          "description": "Unique attendance record identifier generated as ATT-YYYYMMDD-NNN."
        },
        {
          "name": "EmployeeID",
          "accessType": "Short Text",
          "maxLength": 10,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "foreignKey": "Employees.EmployeeID",
          "description": "Identifier of the employee who clocked in."
        },
        {
          "name": "WorkDate",
          "accessType": "Short Text",
          "maxLength": 10,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Work date formatted as ISO-8601 text (YYYY-MM-DD) for Excel Online compatibility."
        },
        {
          "name": "ClockIn",
          "accessType": "Short Text",
          "maxLength": 19,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
          "description": "Clock-in timestamp formatted as ISO-8601 text (YYYY-MM-DD HH:MM:SS)."
        },
        {
          "name": "ClockOut",
          "accessType": "Short Text",
          "maxLength": 19,
          "excelFormat": "@",
          "nullable": true,
          "unique": false,
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2})?$",
          "description": "Clock-out timestamp formatted as ISO-8601 text (YYYY-MM-DD HH:MM:SS), or empty while Status is Working."
        },
        {
          "name": "Status",
          "accessType": "Short Text",
          "maxLength": 20,
          "excelFormat": "@",
          "nullable": false,
          "unique": false,
          "allowedValues": ["Working", "Completed"],
          "description": "Attendance state: Working (clocked in, not yet clocked out) or Completed (clocked out)."
        }
      ]
    }
  ]
}
